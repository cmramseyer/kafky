<% content_for :title, "New Order" %>

<main class="page">
  <div class="page-header">
    <div>
      <h1>New order</h1>
      <p>Selecciona un customer y define cantidades para uno o mas products.</p>
    </div>

    <%= link_to "Back to orders", orders_path, class: "button secondary" %>
  </div>

  <% if @order.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@order.errors.count, "error") %> prevented this order from being saved:</h2>
      <ul>
        <% @order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @order, class: "order-form" do |form| %>
    <div class="field">
      <%= form.label :customer_id, "Customer" %>
      <%= form.collection_select :customer_id, @customers, :id, :name, prompt: "Select a customer" %>
    </div>

    <fieldset class="field">
      <legend>Products</legend>

      <% @products.each do |product| %>
        <label class="checkbox-option quantity-option">
          <span>
            <%= product.name %>
            <small>
              <%= product.category.name %> - <%= number_to_currency(product.price) %> - Stock: <%= product.stock %>
            </small>
          </span>
          <%= number_field_tag "order[product_quantities][#{product.id}]", @product_quantities[product.id.to_s], min: 0, step: 1, placeholder: "Qty" %>
        </label>
      <% end %>
    </fieldset>

    <%= form.submit "Create order", class: "button" %>
  <% end %>
</main>
