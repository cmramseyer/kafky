<% content_for :title, "New Order" %>

<main class="page">
  <div class="page-header">
    <div>
      <h1>New order</h1>
      <p>Selecciona un customer y uno o mas products.</p>
    </div>

    <%= link_to "Back to orders", orders_path, class: "button secondary" %>
  </div>

  <% if @order.errors.any? %>
    <div class="errors">
      <h2><%= pluralize(@order.errors.count, "error") %> prevented this order from being saved:</h2>
      <ul>
        <% @order.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @order, class: "order-form" do |form| %>
    <div class="field">
      <%= form.label :customer_id, "Customer" %>
      <%= form.collection_select :customer_id, @customers, :id, :name, prompt: "Select a customer" %>
    </div>

    <fieldset class="field">
      <legend>Products</legend>

      <%= form.collection_check_boxes :product_ids, @products, :id, :name do |product_field| %>
        <% product = product_field.object %>
        <label class="checkbox-option">
          <%= product_field.check_box %>
          <span>
            <%= product.name %>
            <small><%= product.category.name %> - <%= number_to_currency(product.price) %></small>
          </span>
        </label>
      <% end %>
    </fieldset>

    <%= form.submit "Create order", class: "button" %>
  <% end %>
</main>
